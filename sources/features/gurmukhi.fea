# --------
# Lookups
# --------
# Put Back Halant
lookup GuruPutBackHalant useExtension {
    sub rasubscriptguru by halantguru raguru;
    sub hasubscriptguru by halantguru haguru;
    sub vasubscriptguru by halantguru vaguru;
} GuruPutBackHalant;


# Put Back Addak
lookup GuruPutBackAddak useExtension {
    sub eematraaddakguru by eematraguru addakguru;
    sub aimatraaddakguru by aimatraguru addakguru;
    sub oomatraaddakguru by oomatra1guru addakguru;
    sub aumatraaddakguru by aumatraguru addakguru;
} GuruPutBackAddak;

# Separate Matra and Addak
lookup GuruSeparateMatraAddak useExtension {
    pos aumatraguru <$aumatra_rightfix 0 0 0>;
    pos addakguru <$addak_rightfix 0 0 0>;
    pos aumatrabindiguru <$aumatrabindi_rightfix 0 0 0>;
} GuruSeparateMatraAddak;


# SinglePositioning14
lookup GuruSinglePositioning14 useExtension {
    lookupflag 0;
    ;
    # Original source: 10 
    pos aumatraaddakguru <-1 0 0 0>;
} GuruSinglePositioning14;

