feature blwf {
    script gur2;
    lookup GuruBlwf useExtension {
        sub halantguru haguru by hasubscriptguru;
        sub halantguru raguru by rasubscriptguru;
        sub halantguru vaguru by vasubscriptguru;        
    } GuruBlwf;
} blwf;

feature pstf {
    script gur2;
    lookup GuruPstf useExtension {
        sub halantguru yaguru by yapostformguru;
    } GuruPstf;
} pstf;

feature blws {
    script gur2;
    lookup GuruBlws1 useExtension {
        sub [rasubscriptguru hasubscriptguru vasubscriptguru]' lookup GuruPutBackHalant [udaatguru yakashguru rasubscriptguru hasubscriptguru vasubscriptguru];
    } GuruBlws1;

    lookup GuruBelowLigatures useExtension {
        sub udaatguru halantguru by udaathalantguru;
        sub udaatguru umatraguru by udaatuguru;
        sub udaatguru uumatraguru by udaatuuguru;
        sub yakashguru halantguru by yakashhalantguru;
        sub yakashguru umatraguru by yakashuguru;
        sub yakashguru uumatraguru by yakashuuguru;
        sub rasubscriptguru halantguru by rasubscripthalantguru;
        sub rasubscriptguru umatraguru by rasubscriptuguru;
        sub rasubscriptguru uumatraguru by rasubscriptuuguru;
        sub hasubscriptguru halantguru by hasubscripthalantguru;
        sub hasubscriptguru umatraguru by hasubscriptuguru;
        sub hasubscriptguru uumatraguru by hasubscriptuuguru;
        sub vasubscriptguru halantguru by vasubscripthalantguru;
        sub vasubscriptguru umatraguru by vasubscriptuguru;
        sub vasubscriptguru uumatraguru by vasubscriptuuguru;

        sub kaguru rasubscriptguru by karaguru;
        sub phanuktaguru umatraguru by phunuktaguru;
        sub phanuktaguru uumatraguru by phuunuktaguru;
    } GuruBelowLigatures;

    lookup GuruBlws2 useExtension {
        sub @guru_class1 [rasubscriptguru hasubscriptguru vasubscriptguru]' by [rasubscript1guru hasubscript1guru vasubscript1guru];

        sub @guru_class2 [umatraguru uumatraguru]' by [umatralowguru uumatralowguru];
    } GuruBlws2;

} blws;

